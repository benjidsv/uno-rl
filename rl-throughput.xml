"""The token grid and action index tables the learner's encoder is built on.

docs/rl/pipeline-plan.md section 5 asks for "colored card/rank tokens, separate
semantic action-card kinds, wild tokens, and indexed evidence relations", with no
learned absolute color IDs and no distinguishable embeddings for interchangeable
ranks. This module fixes that indexing once per ruleset.

**The grid.** Every colored card type is a token at `(color, slot)`; `slot`
enumerates the per-color card kinds in a fixed order -- the number ranks that have
copies, then SKIP, REVERSE, DRAW_TWO where the ruleset has them. Wild types are
separate tokens with no color. On `FULL_UNO` that is a 4 x 13 grid plus 2 wilds,
i.e. exactly the 54 card types.

**What the group does to it** (docs/foundations/spec.md section 18, contract
section 1.4). A color permutation permutes the grid's first axis. A rank
permutation within a copy class permutes number slots *within that class* and
fixes the action-card slots; wild tokens are fixed throughout. So a network is
equivariant by construction if it

1. embeds a slot only through `slot_class` -- the (kind, copies) class, equal for
   interchangeable ranks and distinct for distinct semantic kinds -- never through
   the slot index itself, and never through the color index at all;
2. processes every token with shared weights, and pools only over whole axes
   (colors, or the slots of one copy class) or over everything;
3. scores an action from its own token and its own color's context, never from a
   flattened ordered color block.

`slot_class` is what point 1 needs; `class_slots` is what a copy-class-respecting
pool needs; the `act_*` tables are what point 3 needs. Nothing here is learned or
fitted: the tables are a pure function of the `Ruleset`.
"""

from __future__ import annotations

from dataclasses import dataclass
from functools import cache

import numpy as np

from uno.game.engine import is_playable
from uno.game.rules import Draw, Kind, Pass, Play, Ruleset

# action categories, as `Layout.act_kind`
ACT_COLORED, ACT_WILD, ACT_DRAW, ACT_PASS = 0, 1, 2, 3


@dataclass(frozen=True)
class Layout:
    """Per-ruleset token grid, slot classes and action tables (`layout`)."""

    rs: Ruleset
    colors: int
    slots: int  # per-color slots
    wilds: int  # wild tokens
    slot_kind: tuple[int, ...]  # (slots,) Kind of each slot
    slot_rank: tuple[int, ...]  # (slots,) rank of a number slot, else -1
    slot_class: tuple[int, ...]  # (slots,) embedding class: equal iff interchangeable
    wild_class: tuple[int, ...]  # (wilds,) embedding class, disjoint from slot_class
    n_classes: int
    class_slots: tuple[tuple[int, ...], ...]  # slots of each class that has any
    grid_type: np.ndarray  # (colors, slots) type id
    wild_type: np.ndarray  # (wilds,) type id
    type_color: np.ndarray  # (num_types,) color, -1 for wilds
    type_slot: np.ndarray  # (num_types,) slot, -1 for wilds
    type_wild: np.ndarray  # (num_types,) wild index, -1 for colored
    deck_counts: np.ndarray  # (num_types,) float
    playable: np.ndarray  # (num_types, colors, num_types) bool: playable[top, color, card]
    # action tables
    act_kind: np.ndarray  # (num_actions,) ACT_*
    act_token: np.ndarray  # (num_actions,) index into the flattened token list, -1
    act_color: np.ndarray  # (num_actions,) color whose context the action reads, -1
    act_card: np.ndarray  # (num_actions,) played type id, -1 for Draw/Pass
    act_feat: np.ndarray  # (num_actions, act_feat_width) invariant static descriptor

    @property
    def n_tokens(self) -> int:
        """Grid tokens then wild tokens, as the model flattens them."""
        return self.colors * self.slots + self.wilds

    @property
    def act_feat_width(self) -> int:
        return self.act_feat.shape[1]

    def token_index(self, color: int, slot: int) -> int:
        return color * self.slots + slot

    def wild_index(self, wild: int) -> int:
        return self.colors * self.slots + wild


@cache
def layout(rs: Ruleset) -> Layout:
    """The token grid and action tables of a ruleset. Cached: pure and reused hot."""
    types = rs.card_types
    # -- slots ------------------------------------------------------------------
    slot_kind: list[int] = []
    slot_rank: list[int] = []
    slot_class: list[int] = []
    copy_class: dict[int, int] = {}
    for rank, copies in enumerate(rs.rank_copies):
        if copies > 0:
            slot_kind.append(int(Kind.NUMBER))
            slot_rank.append(rank)
            slot_class.append(copy_class.setdefault(copies, len(copy_class)))
    n_class = len(copy_class)
    for kind, per_color in ((Kind.SKIP, rs.skip_per_color), (Kind.REVERSE, rs.reverse_per_color), (Kind.DRAW_TWO, rs.draw_two_per_color)):
        if per_color > 0:
            slot_kind.append(int(kind))
            slot_rank.append(-1)
            slot_class.append(n_class)
            n_class += 1
    wild_kinds = [k for k, n in ((Kind.WILD, rs.wild_count), (Kind.WILD_DRAW_FOUR, rs.wild_draw_four_count)) if n > 0]
    wild_class = []
    for _ in wild_kinds:
        wild_class.append(n_class)
        n_class += 1
    slots, wilds = len(slot_kind), len(wild_kinds)

    # -- the grid ---------------------------------------------------------------
    index = {(int(t.kind), -1 if t.color is None else t.color, -1 if t.rank is None else t.rank): i for i, t in enumerate(types)}
    grid = np.empty((rs.colors, slots), dtype=np.int64)
    for c in range(rs.colors):
        for s in range(slots):
            grid[c, s] = index[(slot_kind[s], c, slot_rank[s])]
    wild_type = np.array([index[(int(k), -1, -1)] for k in wild_kinds], dtype=np.int64)

    type_color = np.full(rs.num_types, -1, dtype=np.int64)
    type_slot = np.full(rs.num_types, -1, dtype=np.int64)
    type_wild = np.full(rs.num_types, -1, dtype=np.int64)
    for c in range(rs.colors):
        for s in range(slots):
            type_color[grid[c, s]] = c
            type_slot[grid[c, s]] = s
    for w, t in enumerate(wild_type):
        type_wild[t] = w

    playable = np.zeros((rs.num_types, rs.colors, rs.num_types), dtype=bool)
    for top in range(rs.num_types):
        for color in range(rs.colors):
            playable[top, color] = [is_playable(rs, card, top, color) for card in range(rs.num_types)]

    # -- actions ----------------------------------------------------------------
    n_a = rs.num_actions
    act_kind = np.empty(n_a, dtype=np.int64)
    act_token = np.full(n_a, -1, dtype=np.int64)
    act_color = np.full(n_a, -1, dtype=np.int64)
    act_card = np.full(n_a, -1, dtype=np.int64)
    max_copies = float(max(rs.deck_counts))
    feats: list[list[float]] = []
    for i, a in enumerate(rs.actions):
        f = [0.0] * (4 + len(Kind) + 1)
        match a:
            case Play(card=card, color=color):
                ct = types[card]
                act_card[i] = card
                f[4 + int(ct.kind)] = 1.0
                f[-1] = rs.deck_counts[card] / max_copies
                if ct.is_wild:
                    act_kind[i] = ACT_WILD
                    act_token[i] = rs.colors * slots + int(type_wild[card])
                    act_color[i] = color
                    f[ACT_WILD] = 1.0
                else:
                    act_kind[i] = ACT_COLORED
                    act_token[i] = int(type_color[card]) * slots + int(type_slot[card])
                    act_color[i] = int(type_color[card])
                    f[ACT_COLORED] = 1.0
            case Draw():
                act_kind[i] = ACT_DRAW
                f[ACT_DRAW] = 1.0
            case Pass():
                act_kind[i] = ACT_PASS
                f[ACT_PASS] = 1.0
        feats.append(f)

    class_slots = tuple(tuple(s for s in range(slots) if slot_class[s] == k) for k in range(n_class))
    return Layout(
        rs=rs,
        colors=rs.colors,
        slots=slots,
        wilds=wilds,
        slot_kind=tuple(slot_kind),
        slot_rank=tuple(slot_rank),
        slot_class=tuple(slot_class),
        wild_class=tuple(wild_class),
        n_classes=n_class,
        class_slots=tuple(cs for cs in class_slots if cs),
        grid_type=grid,
        wild_type=wild_type,
        type_color=type_color,
        type_slot=type_slot,
        type_wild=type_wild,
        deck_counts=np.asarray(rs.deck_counts, dtype=np.float64),
        playable=playable,
        act_kind=act_kind,
        act_token=act_token,
        act_color=act_color,
        act_card=act_card,
        act_feat=np.asarray(feats, dtype=np.float64),
    )
</file>

<file path="uno/rl/manifest.py">
"""Episode manifests, deal partitions and the DEV evaluation panel.

docs/rl/pipeline-plan.md section 3: the complete episode manifest for an
iteration is created **before** any work is dispatched, with equal completed-game
quotas on the eight opponent x learner-seat cells. A fixed game count, not a race
to the first N decisions: selecting the fastest completed games would favor short
trajectories, and a predetermined manifest makes worker count an execution
setting rather than a data-allocation setting.

Section 4's proposed DEV partition, which this module owns:

| Deal seeds | Use |
|---|---|
| `[0, 800000)` | training deals |
| `[800000, 900000)` | fixed scheduled selection panels |
| `[900000, 1000000)` | pilot sizing and diagnostic/holdout panels |

All three are **DEV** partitions inside `uno.eval.seeds.DEV_POOL`; none of them is
confirmatory data. A frozen claim still claims a fresh block of `EVAL_POOL`.
Training deals cycle through a seeded permutation when the finite pool is
exhausted; the cycle count is logged and the schedule never drifts into EVAL.
"""

from __future__ import annotations

from dataclasses import dataclass

import numpy as np

from uno.eval.seeds import DEV_POOL
from uno.rl.streams import SCHEDULE, generator

TRAIN_DEALS = range(0, 800_000)
PANEL_DEALS = range(800_000, 900_000)
DIAGNOSTIC_DEALS = range(900_000, 1_000_000)

assert TRAIN_DEALS.start >= DEV_POOL.start and DIAGNOSTIC_DEALS.stop <= DEV_POOL.stop


@dataclass(frozen=True, slots=True)
class Episode:
    """One assigned game. Training metadata, never actor input (section 4)."""

    episode_id: int  # logical, globally increasing within a training lineage
    deal_seed: int
    opponent: str
    seat: int  # the learner's seat
    cycle: int  # how many times the training deal pool had been exhausted


@dataclass(frozen=True)
class Manifest:
    """The complete episode assignment of one iteration."""

    update: int
    episodes: tuple[Episode, ...]
    cells: tuple[tuple[str, int], ...]
    games_per_cell: int

    def __len__(self) -> int:
        return len(self.episodes)

    @property
    def deal_seeds(self) -> tuple[int, ...]:
        return tuple(e.deal_seed for e in self.episodes)


class DealSchedule:
    """The training deal order: a seeded permutation of `TRAIN_DEALS`, cycled.

    Position and cycle count are checkpoint state, so a resumed run continues the
    schedule rather than replaying deals it has already trained on.
    """

    def __init__(self, training_seed: int, position: int = 0, cycle: int = 0, pool: range = TRAIN_DEALS) -> None:
        self.training_seed, self.pool = training_seed, pool
        self.position, self.cycle = position, cycle
        self._order: np.ndarray | None = None

    def _permutation(self, cycle: int) -> np.ndarray:
        return generator(self.training_seed, SCHEDULE, "deals", cycle).permutation(len(self.pool)) + self.pool.start

    def take(self, n: int) -> list[tuple[int, int]]:
        """The next `n` (deal seed, cycle) pairs, advancing the schedule."""
        out: list[tuple[int, int]] = []
        while len(out) < n:
            if self._order is None:
                self._order = self._permutation(self.cycle)
            remaining = len(self._order) - self.position
            take = min(n - len(out), remaining)
            out += [(int(s), self.cycle) for s in self._order[self.position : self.position + take]]
            self.position += take
            if self.position >= len(self._order):
                self.cycle += 1
                self.position = 0
                self._order = None
        return out

    @property
    def state(self) -> dict:
        return {"position": self.position, "cycle": self.cycle, "pool_start": self.pool.start, "pool_stop": self.pool.stop}

    @classmethod
    def from_state(cls, training_seed: int, state: dict) -> DealSchedule:
        return cls(training_seed, state["position"], state["cycle"], range(state["pool_start"], state["pool_stop"]))


def cells(opponents, seats: tuple[int, ...] = (0, 1)) -> tuple[tuple[str, int], ...]:
    """The opponent x learner-seat cells, in a fixed order.

    `seats` is `(0, 1)` for the league objective, which balances both seats. A toy
    diagnostic that reports the two seats separately passes one of them (pipeline
    plan section 3: "For fixed-opponent toys, balance the two seats" -- balanced
    across the pair of runs, not inside one gradient check)."""
    return tuple((name, seat) for name in opponents for seat in seats)


def build(update: int, opponents, schedule: DealSchedule, games_per_cell: int, next_episode_id: int, seats: tuple[int, ...] = (0, 1)) -> tuple[Manifest, int]:
    """The next iteration's complete manifest, and the next free episode id.

    Every cell gets the same number of games and its own deals. A deal seed is
    used by exactly one cell within an iteration, so a cell's score is not
    coupled to another cell's by a shared deal during *training*; paired
    evaluation, where coupling is wanted, is `uno.rl.evaluate`'s job.
    """
    cs = cells(opponents, seats)
    drawn = schedule.take(len(cs) * games_per_cell)
    episodes: list[Episode] = []
    eid = next_episode_id
    for i, (name, seat) in enumerate(cs):
        for j in range(games_per_cell):
            deal, cycle = drawn[i * games_per_cell + j]
            episodes.append(Episode(eid, deal, name, seat, cycle))
            eid += 1
    return Manifest(update, tuple(episodes), cs, games_per_cell), eid


def panel(opponents, deals_per_cell: int, start: int = PANEL_DEALS.start, seats: tuple[int, ...] = (0, 1)) -> Manifest:
    """The fixed, disjoint DEV evaluation panel: the same deals in every cell.

    Contract for section 9: balanced over opponents and seats, and coupled -- all
    cells share the deal block, so a paired difference can group every seat and
    opponent that shares a deal. It is fixed across checkpoints and variants, and
    it is not resized because a checkpoint looks good.
    """
    if start + deals_per_cell > PANEL_DEALS.stop:
        raise ValueError("the panel would run past the DEV panel partition")
    cs = cells(opponents, seats)
    episodes = []
    for i, (name, seat) in enumerate(cs):
        for j in range(deals_per_cell):
            episodes.append(Episode(i * deals_per_cell + j, start + j, name, seat, 0))
    return Manifest(-1, tuple(episodes), cs, deals_per_cell)


def diagnostic_panel(
    opponents,
    deals_per_cell: int,
    start: int = DIAGNOSTIC_DEALS.start,
    seats: tuple[int, ...] = (0, 1),
) -> Manifest:
    """A coupled DEV panel reserved for sizing and other bounded diagnostics.

    This deliberately does not consume the fixed scheduled-selection panel.  It
    has the same opponent/seat/deal coupling, so its paired variance estimates
    transfer to choosing that panel's size without selecting on its outcomes.
    """
    if start < DIAGNOSTIC_DEALS.start or start + deals_per_cell > DIAGNOSTIC_DEALS.stop:
        raise ValueError("the diagnostic panel would run outside its DEV partition")
    cs = cells(opponents, seats)
    episodes = []
    offset = start - DIAGNOSTIC_DEALS.start
    for i, (name, seat) in enumerate(cs):
        for j in range(deals_per_cell):
            # Independent of the requested width, so extending a sizing panel
            # preserves every existing policy and opponent random stream.
            episode_id = i * len(DIAGNOSTIC_DEALS) + offset + j
            episodes.append(Episode(episode_id, start + j, name, seat, 0))
    return Manifest(-1, tuple(episodes), cs, deals_per_cell)


__all__ = [
    "DIAGNOSTIC_DEALS", "PANEL_DEALS", "TRAIN_DEALS", "DealSchedule", "Episode",
    "Manifest", "build", "cells", "diagnostic_panel", "panel",
]  # fmt: skip
</file>

<file path="uno/rl/model.py">
"""The feed-forward actor and the separate critic, equivariant by construction.

docs/rl/pipeline-plan.md section 5 specifies the architecture this implements:
width 128, FP32, no dropout or normalization, a shared token projection, two
shared relational blocks with residual updates, and one shared action scorer.
Temperature is 1 everywhere, in collection, learning, evaluation and replay.

**Where the symmetry lives.** Nothing canonicalizes an observation. The inputs
are indexed by color and slot (`uno.rl.features`), and every operation here is
one of three kinds:

- *shared per token*: the same weights for every `(color, slot)` and every wild;
- *pooled over a whole axis*: mean and max over colors, over the slots of one
  color, over the slots of one copy class, or over everything -- all of which are
  permutation invariant;
- *indexed scoring*: an action reads its own token and its own color's context.

A slot is embedded only through `slot_class`, so two interchangeable ranks are
indistinguishable to the network and two distinct semantic kinds are not merged.
Consequently relabeling colors or ranks relabels the output probabilities exactly,
including equality inside stabilizer action orbits -- asserted numerically over
the real group in `tests/rl/test_model.py` rather than assumed here.

**What this is not.** A concrete architecture proposal with recorded shapes and
parameter counts, not a proof that it can express a good policy. The critic
shares no parameters, no normalization and no state with the actor, and the actor
export excludes it (contract section 3).
"""

from __future__ import annotations

from dataclasses import dataclass

import numpy as np
import torch
from torch import nn

from uno.rl.features import Features, Spec

WIDTH = 128
BLOCKS = 2


def _pool(x: torch.Tensor, dim: int) -> torch.Tensor:
    """Mean and max over `dim`, concatenated: a permutation-invariant summary."""
    return torch.cat((x.mean(dim=dim), x.amax(dim=dim)), dim=-1)


class Encoder(nn.Module):
    """Shared token projection plus `BLOCKS` relational blocks.

    Returns `(grid, wild, color_ctx, global_ctx)`:
    `grid` is `(n, colors, slots, width)`, `wild` is `(n, wilds, width)`,
    `color_ctx` is `(n, colors, 2 * width)` and `global_ctx` is
    `(n, 6 * width)` -- the colors pooled twice over and the pooled wilds.
    """

    def __init__(self, sp: Spec, width: int = WIDTH, blocks: int = BLOCKS) -> None:
        super().__init__()
        lay = sp.layout
        self.spec, self.width, self.blocks = sp, width, blocks
        self.colors, self.slots, self.wilds = lay.colors, lay.slots, lay.wilds
        self.embed = nn.Embedding(lay.n_classes, width)
        # one projection for every token; a wild has no color block, so its color
        # features enter as zeros rather than as a second set of weights.
        self.proj = nn.Linear(sp.tok_width + sp.col_width + width + sp.glob_width, width)
        # grid update sees its own token, its color, its rank across colors, its
        # copy class and the global context: 1 + 2 + 2 + 2 + 6 widths.
        self.grid_blocks = nn.ModuleList(
            nn.Sequential(nn.Linear(13 * width, width), nn.ReLU(), nn.Linear(width, width)) for _ in range(blocks)
        )
        # a wild token has no color and no rank index, so it sees itself and the global context.
        self.wild_blocks = nn.ModuleList(
            nn.Sequential(nn.Linear(7 * width, width), nn.ReLU(), nn.Linear(width, width)) for _ in range(blocks)
        )
        # slot -> compacted copy-class id, for the class pool
        classes = sorted({lay.slot_class[s] for s in range(lay.slots)})
        remap = {c: i for i, c in enumerate(classes)}
        self.n_slot_classes = len(classes)
        self.register_buffer("slot_class", torch.tensor([remap[lay.slot_class[s]] for s in range(lay.slots)], dtype=torch.long), persistent=False)
        member = torch.zeros(len(classes), lay.slots)
        member[self.slot_class, torch.arange(lay.slots)] = 1.0
        self.register_buffer("class_member", member, persistent=False)  # (classes, slots)
        self.register_buffer("class_size", member.sum(1), persistent=False)
        self.register_buffer("token_class", torch.tensor(list(lay.slot_class), dtype=torch.long), persistent=False)
        self.register_buffer("wild_class_ids", torch.tensor(list(lay.wild_class), dtype=torch.long), persistent=False)

    def _class_ctx(self, h: torch.Tensor) -> torch.Tensor:
        """Pool the slots of each copy class, over colors too, and broadcast back.

        `h` is `(n, colors, slots, width)`. Interchangeable ranks share a class, so
        this pool is invariant under the group and distinct semantic kinds keep
        their own summary.
        """
        n, c, s, w = h.shape
        k = self.n_slot_classes
        per_slot = h.permute(0, 2, 1, 3)  # (n, slots, colors, width)
        mem = self.class_member.view(1, k, s, 1)
        means = (per_slot.mean(2).unsqueeze(1) * mem).sum(2) / self.class_size.view(1, k, 1)
        over_colors = per_slot.amax(2).unsqueeze(1).expand(n, k, s, w)
        maxes = torch.where(mem.bool(), over_colors, torch.full_like(over_colors, float("-inf"))).amax(2)
        ctx = torch.cat((means, maxes), dim=-1)  # (n, classes, 2w)
        return ctx[:, self.slot_class]  # (n, slots, 2w)

    def forward(self, tok: torch.Tensor, col: torch.Tensor, glob: torch.Tensor):
        n = tok.shape[0]
        c, s, wl, w = self.colors, self.slots, self.wilds, self.width
        grid_in = tok[:, : c * s].reshape(n, c, s, -1)
        wild_in = tok[:, c * s :]
        g = glob.unsqueeze(1)
        grid_x = torch.cat(
            (
                grid_in,
                col.unsqueeze(2).expand(n, c, s, col.shape[-1]),
                self.embed(self.token_class).unsqueeze(0).unsqueeze(0).expand(n, c, s, w),
                g.unsqueeze(1).expand(n, c, s, glob.shape[-1]),
            ),
            dim=-1,
        )
        wild_x = torch.cat(
            (
                wild_in,
                torch.zeros(n, wl, col.shape[-1], device=tok.device, dtype=tok.dtype),
                self.embed(self.wild_class_ids).unsqueeze(0).expand(n, wl, w),
                g.expand(n, wl, glob.shape[-1]),
            ),
            dim=-1,
        )
        h = torch.relu(self.proj(grid_x))
        hw = torch.relu(self.proj(wild_x))

        for grid_block, wild_block in zip(self.grid_blocks, self.wild_blocks):
            color_ctx = _pool(h, 2)  # (n, colors, 2w)
            rank_ctx = _pool(h, 1)  # (n, slots, 2w)
            class_ctx = self._class_ctx(h)  # (n, slots, 2w)
            wild_ctx = _pool(hw, 1)  # (n, 2w)
            global_ctx = torch.cat((color_ctx.mean(1), color_ctx.amax(1), wild_ctx), dim=-1)  # (n, 6w)
            grid_update = grid_block(
                torch.cat(
                    (
                        h,
                        color_ctx.unsqueeze(2).expand(n, c, s, 2 * w),
                        rank_ctx.unsqueeze(1).expand(n, c, s, 2 * w),
                        class_ctx.unsqueeze(1).expand(n, c, s, 2 * w),
                        global_ctx.unsqueeze(1).unsqueeze(1).expand(n, c, s, 6 * w),
                    ),
                    dim=-1,
                )
            )
            wild_update = wild_block(torch.cat((hw, global_ctx.unsqueeze(1).expand(n, wl, 6 * w)), dim=-1))
            h = h + grid_update
            hw = hw + wild_update

        color_ctx = _pool(h, 2)
        wild_ctx = _pool(hw, 1)
        global_ctx = torch.cat((color_ctx.mean(1), color_ctx.amax(1), wild_ctx), dim=-1)
        return h, hw, color_ctx, global_ctx


class Actor(nn.Module):
    """Encoder plus the shared action scorer. Outputs raw logits; masking is the
    policy's job (`masked_log_probs`), so one convention serves every path."""

    def __init__(self, sp: Spec, width: int = WIDTH, blocks: int = BLOCKS) -> None:
        super().__init__()
        lay = sp.layout
        self.spec, self.width = sp, width
        self.encoder = Encoder(sp, width, blocks)
        self.score = nn.Sequential(nn.Linear(width + 2 * width + 6 * width + lay.act_feat_width, width), nn.ReLU(), nn.Linear(width, 1))
        self.register_buffer("act_token", torch.tensor(lay.act_token, dtype=torch.long).clamp(min=0), persistent=False)
        self.register_buffer("act_has_token", torch.tensor(lay.act_token >= 0, dtype=torch.float32), persistent=False)
        self.register_buffer("act_color", torch.tensor(lay.act_color, dtype=torch.long).clamp(min=0), persistent=False)
        self.register_buffer("act_has_color", torch.tensor(lay.act_color >= 0, dtype=torch.float32), persistent=False)
        self.register_buffer("act_feat", torch.tensor(lay.act_feat, dtype=torch.float32), persistent=False)

    def forward(self, tok: torch.Tensor, col: torch.Tensor, glob: torch.Tensor) -> torch.Tensor:
        n = tok.shape[0]
        h, hw, color_ctx, global_ctx = self.encoder(tok, col, glob)
        tokens = torch.cat((h.reshape(n, -1, self.width), hw), dim=1)  # (n, n_tokens, w)
        a = self.act_token.shape[0]
        tok_a = tokens[:, self.act_token] * self.act_has_token.view(1, a, 1)
        col_a = color_ctx[:, self.act_color] * self.act_has_color.view(1, a, 1)
        x = torch.cat(
            (tok_a, col_a, global_ctx.unsqueeze(1).expand(n, a, global_ctx.shape[-1]), self.act_feat.unsqueeze(0).expand(n, a, -1)),
            dim=-1,
        )
        return self.score(x).squeeze(-1)


class Critic(nn.Module):
    """Separate structured invariant network with a scalar linear value head."""

    def __init__(self, sp: Spec, width: int = WIDTH, blocks: int = BLOCKS) -> None:
        super().__init__()
        self.spec = sp
        self.encoder = Encoder(sp, width, blocks)
        self.head = nn.Linear(6 * width, 1)

    def forward(self, tok: torch.Tensor, col: torch.Tensor, glob: torch.Tensor) -> torch.Tensor:
        _, _, _, global_ctx = self.encoder(tok, col, glob)
        return self.head(global_ctx).squeeze(-1)


# -- the one masking / probability convention ----------------------------------


def masked_log_probs(logits: torch.Tensor, mask: torch.Tensor, temperature: float = 1.0) -> torch.Tensor:
    """Log-softmax over the legal actions only, at `temperature`.

    The single convention used by collection, the PPO loss, evaluation and replay
    (contract section 1.1). An all-illegal row is a caller bug, not something to
    paper over with a uniform fallback, so it raises.
    """
    if not bool(mask.any(dim=-1).all()):
        raise ValueError("a decision row has no legal action")
    z = logits / temperature
    z = z.masked_fill(~mask, float("-inf"))
    return torch.log_softmax(z, dim=-1)


def entropy_from_log_probs(logp: torch.Tensor) -> torch.Tensor:
    """Per-row entropy in nats, with the -inf of illegal actions contributing zero."""
    p = logp.exp()
    return -(p * torch.where(torch.isfinite(logp), logp, torch.zeros_like(logp))).sum(-1)


def to_tensors(f: Features, device: torch.device | str = "cpu") -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
    return (
        torch.from_numpy(np.ascontiguousarray(f.tok)).to(device),
        torch.from_numpy(np.ascontiguousarray(f.col)).to(device),
        torch.from_numpy(np.ascontiguousarray(f.glob)).to(device),
    )


@dataclass(frozen=True)
class Shapes:
    """Recorded tensor shapes and parameter counts (pipeline plan section 5)."""

    arm: str
    width: int
    blocks: int
    tokens: int
    colors: int
    slots: int
    wilds: int
    tok_width: int
    col_width: int
    glob_width: int
    actions: int
    actor_params: int
    critic_params: int

    def __str__(self) -> str:
        return (
            f"arm {self.arm} width {self.width} x {self.blocks} blocks: {self.tokens} tokens "
            f"({self.colors} x {self.slots} + {self.wilds}), channels {self.tok_width}/{self.col_width}/{self.glob_width}, "
            f"{self.actions} actions, actor {self.actor_params:,} params, critic {self.critic_params:,} params"
        )


def shapes(actor_spec: Spec, critic_spec: Spec, width: int = WIDTH, blocks: int = BLOCKS) -> Shapes:
    lay = actor_spec.layout
    actor = Actor(actor_spec, width, blocks)
    critic = Critic(critic_spec, width, blocks)
    return Shapes(
        arm=actor_spec.arm, width=width, blocks=blocks, tokens=lay.n_tokens, colors=lay.colors, slots=lay.slots, wilds=lay.wilds,
        tok_width=actor_spec.tok_width, col_width=actor_spec.col_width, glob_width=actor_spec.glob_width, actions=lay.rs.num_actions,
        actor_params=sum(p.numel() for p in actor.parameters()), critic_params=sum(p.numel() for p in critic.parameters()),
    )  # fmt: skip
